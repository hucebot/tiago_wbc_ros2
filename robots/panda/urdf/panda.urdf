  <!-- link8 above is the bare flange (no rotation) - the vendored MuJoCo model's "hand"
       body is mounted at the SAME position but rotated -45deg about Z (standard Franka
       hand-mounting convention, read directly off panda.xml's own
       quat="0.9238795 0 0 -0.3826834" on the hand body, not assumed from memory), then the
       "ee_panda" site sits a further 0.1034m along the hand's local Z (the same tcp
       convention documented in panda.xml). Mirrored here as two more fixed links so
       OpenSoT's Cartesian task can target a URDF frame ("ee_panda") that is the exact same
       pose as what MuJoCo reports for its "ee_panda" site - targeting "link8" directly
       instead would silently solve for the wrong orientation (and to a lesser extent
       position) by a constant, easy-to-miss 45-degree-ish offset. -->
  <link name="hand"/>
  <joint name="hand_joint" type="fixed">
    <origin rpy="0 0 -0.7853981633974483" xyz="0 0 0"/>
    <parent link="link8"/>
    <child link="hand"/>
  </joint>
  <link name="ee_panda"/>
  <joint name="ee_panda_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.1034"/>
    <parent link="hand"/>
    <child link="ee_panda"/>
  </joint>
  <link name="world"/>
  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="link0"/>
  </joint>
