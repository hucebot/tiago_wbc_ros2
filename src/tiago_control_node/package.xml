<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tiago_control_node</name>
  <version>0.5.0</version>
  <description>Tiago OpenSoT Control Node</description>
  <maintainer email="dionis.totsila@inria.fr">Dionis Totsila</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>control_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>
  <depend>python3-urdfdom-py</depend>
  <depend>python3-yaml</depend>

  <!-- Runtime-only, not on rosdep: pyopensot, pyopensot_collision, xbot2_interface.
       These come from the prebuilt image (see .ci/Dockerfile / .ci/Dockerfile.base). -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>